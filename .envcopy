# --- CONFIGURACIÓN DEL SISTEMA ---
SIMULATION_MODE=false

# --- CREDENCIALES DE BINANCE ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- INTELIGENCIA ARTIFICIAL (OpenRouter) ---
# Puedes poner varias llaves separadas por comas
OPENROUTER_API_KEYS=""
MODELOS="openai/gpt-4o,anthropic/claude-3-opus,google/gemini-3-flash-preview"

# --- REGLAS DE TRADING ---

MIN_TRADE_USD=5
MIN_MOVEMENT_PERCENT=3
MAX_ACTIVE_SLOTS=1
RISK_PER_TRADE=0.005

# --- PERSISTENCIA (PostgreSQL) ---
DB_DSN="postgresql://postgres:1234@localhost:5432/trading"

# --- INTERFAZ TELEGRAM ---
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_IDS=""
